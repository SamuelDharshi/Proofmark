# ---- Gateway ----
PORT=8787
PUBLIC_GATEWAY_URL=http://localhost:8787
DATA_DIR=./data

# ---- Hedera testnet ----
# Gateway settlement account (receives x402 payments, forwards to maintainers) and HCS submitter
HEDERA_GATEWAY_ACCOUNT_ID=
HEDERA_GATEWAY_PRIVATE_KEY=
# HCS topic id. Leave empty and run: npm run hcs:create -w @proofmark/gateway
HCS_TOPIC_ID=
X402_FACILITATOR_URL=https://api.testnet.blocky402.com
# Asset paid over x402. 0.0.0 = HBAR. Set to a USDC token id only after confirming it on the facilitator.
X402_ASSET=0.0.0
# Demo conversion used to turn the USD price into tinybars
HBAR_USD=0.10
CONNECT_PRICE_USD=0.002
MAX_PRICE_USD=0.05

# ---- Agent (the paying client) ----
AGENT_HEDERA_ACCOUNT_ID=
# The agent's wallet. Its EVM address is recorded on its ENS name by agents:create.
AGENT_HEDERA_PRIVATE_KEY=
AGENT_ENS_NAME=claude-1.agents.proofmark.eth

# ---- Attestation signing key (EVM, hex) ----
ATTEST_PRIVATE_KEY=

# ---- ENS (Sepolia) ----
SEPOLIA_RPC_URL=
ENS_ADMIN_PRIVATE_KEY=
ENS_ROOT_NAME=proofmark.eth

# ---- World ----
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
WORLD_ENVIRONMENT=staging
WORLD_ACTION=claim-mcp-server

# ---- World ID Agent Pass (official World IdP, OpenID Connect) ----
# Register a confidential client at https://auth.world.org/portal. Sandbox issuer: https://sandbox.auth.world.org
WORLD_IDP_ISSUER=https://auth.world.org
WORLD_IDP_CLIENT_ID=
WORLD_IDP_CLIENT_SECRET=
# The method the client was registered with: basic (client_secret_basic) or post (client_secret_post)
WORLD_IDP_AUTH_METHOD=basic
# How old a World ID authentication may be before an agent loses its authority to spend
PASS_MAX_AGE_SECONDS=86400

# ---- Web ----
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8787
NEXT_PUBLIC_WORLD_APP_ID=

# Container engine for sandboxed attestation (default: docker). Docker Engine inside WSL2:
# DOCKER_BIN=wsl -u root docker

# HTS NFT collection for attestation certificates (npm run hts:create)
HTS_TOKEN_ID=
